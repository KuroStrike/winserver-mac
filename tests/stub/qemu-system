#!/usr/bin/env python3
"""Stand-in for qemu-system-* in tests.

Understands just enough of the command line winserver builds: writes the
pidfile, serves the HMP monitor and QMP sockets (logging every command next
to the pidfile), pretends sshd came up on the forwarded SSH port after a
short delay, and exits on `quit` or `system_powerdown`. With STUB_GUEST_RESET
set and `-action reboot=shutdown` on the command line, it also plays Setup's
first reboot: a QMP SHUTDOWN event with reason "guest-reset".
"""
import json
import os
import re
import socket
import sys
import threading
import time

args = sys.argv[1:]

if "--version" in args:
    print("QEMU emulator version 99.0.0 (winserver test stub)")
    sys.exit(0)
if args[:2] == ["-accel", "help"]:
    print("Accelerators supported in QEMU binary:\ntcg\nhvf")
    sys.exit(0)


def opt(name):
    return args[args.index(name) + 1] if name in args else None


pidfile = opt("-pidfile")
monitor = opt("-monitor")
qmp = opt("-qmp")
netdev = opt("-netdev") or ""
sock_path = re.match(r"unix:(.*?),server", monitor).group(1).replace(",,", ",")
log_path = os.path.join(os.path.dirname(pidfile), "monitor.log")
qmp_path = re.match(r"unix:(.*?),server", qmp).group(1).replace(",,", ",") if qmp else None
qmp_log = os.path.join(os.path.dirname(pidfile), "qmp.log")
ssh_port = int(re.search(r"hostfwd=tcp:127\.0\.0\.1:(\d+)-:22", netdev).group(1))

if "-daemonize" in args:
    if os.fork() > 0:
        time.sleep(0.5)
        sys.exit(0)
    os.setsid()

with open(pidfile, "w") as f:
    f.write(str(os.getpid()))


def shutdown():
    for path in (pidfile, sock_path, qmp_path):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    os._exit(0)


def serve_ssh():
    time.sleep(float(os.environ.get("STUB_SSH_DELAY", "2")))
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(("127.0.0.1", ssh_port))
    srv.listen()
    while True:
        conn, _ = srv.accept()
        conn.sendall(b"SSH-2.0-OpenSSH_for_Windows_stub\r\n")
        conn.close()


def serve_qmp():
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(qmp_path)
    srv.listen()
    while True:
        conn, _ = srv.accept()
        f = conn.makefile("rw", encoding="utf-8")
        f.write(json.dumps({"QMP": {"version": {}, "capabilities": []}}) + "\n")
        f.flush()
        for line in f:
            cmd = json.loads(line)
            with open(qmp_log, "a") as log:
                log.write(json.dumps(cmd) + "\n")
            f.write(json.dumps({"return": {}}) + "\n")
            f.flush()
            if cmd.get("execute") == "quit":
                shutdown()
            if cmd.get("execute") == "qmp_capabilities" and "-action" in args and os.environ.get("STUB_GUEST_RESET"):
                time.sleep(float(os.environ["STUB_GUEST_RESET"]))
                f.write(json.dumps({"event": "SHUTDOWN", "data": {"guest": True, "reason": "guest-reset"}}) + "\n")
                f.flush()


threading.Thread(target=serve_ssh, daemon=True).start()
if qmp_path:
    threading.Thread(target=serve_qmp, daemon=True).start()

mon = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
mon.bind(sock_path)
mon.listen()
while True:
    conn, _ = mon.accept()
    conn.sendall(b"QEMU 99.0.0 monitor - type 'help' for more information\r\n(qemu) ")
    buf = b""
    while True:
        data = conn.recv(4096)
        if not data:
            break
        buf += data
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            cmd = line.decode().strip()
            with open(log_path, "a") as f:
                f.write(cmd + "\n")
            if cmd in ("quit", "system_powerdown"):
                conn.close()
                shutdown()
            conn.sendall(b"(qemu) ")
    conn.close()
